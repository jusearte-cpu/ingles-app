# Ninguna de estas variables es necesaria para desarrollo local (Etapa 2):
# sin ellas, la app usa el proveedor mock (ver src/lib/ai/), que nunca
# pretende ser una evaluación de IA real.

# Tutor de IA (Anthropic). Cuando exista, implementar
# src/lib/ai/anthropic-provider.ts y resolverlo en src/lib/ai/index.ts.
ANTHROPIC_API_KEY=

# Para cuando se conecte Supabase (sincronización real entre dispositivos) —
# ver docs/SETUP-CLOUD.md paso a paso. Mientras estas dos falten, /login
# muestra "no configurado" y el middleware no hace nada (modo local intacto).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Para scripts/migrate-to-supabase.ts solamente — NUNCA se expone al cliente,
# NUNCA se sube a Vercel como variable NEXT_PUBLIC_*. Dashboard de Supabase →
# Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública real una vez desplegado (Vercel te la da). En local, déjala
# como está.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
